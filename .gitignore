.DS_Store

# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Unit test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Environments
.env
.venv
venv/

# IDE
.mypy_cache/
.python-version

# Project-specific
dev/
backup/
*.svg
*.png
*.pdf
*.csv
*.log

# Documentation figures are tracked even though plot outputs are not
!docs/*.svg
